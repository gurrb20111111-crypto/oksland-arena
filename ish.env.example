# 아이폰 iSH 교실 서버 설정 — 이 파일을 ish.env 로 복사해서 고쳐 쓰세요 (ish.env는 GitHub에 안 올라감)
export PORT=3000

# 이 서버의 관리자(TV)·운영자 비밀번호. 학생이 추측하기 어려운 값으로.
export ADMIN_KEY=여기에_아이폰_관리자_비밀번호

# Render 안내소 열쇠 = Render → oksland-arena → Environment 의 ADMIN_KEY 값과 똑같이.
# 이걸 적으면 학생은 늘 쓰던 Render 주소(QR)로 들어와도 이 아이폰 서버로 자동 연결돼요.
export HUB_KEY=여기에_Render_ADMIN_KEY_값

# 와이파이 IP를 자동으로 못 찾을 때만 (아이폰 설정 > Wi-Fi > (i) > IP 주소)
# export LAN_IP=192.168.0.23

# 켜자마자 학생을 넘기지 않으려면 0 (나중에 교실주소/hub 에서 켜기)
# export ROUTE=0

# 클리어 코드 없이 이름만으로 아레나 입장 (관리 화면 [클리어 코드가 있어야 입장] 체크로도 바꿀 수 있음)
# export GATE=0
